# Name of the Atari program, without its filename extension.
NAME := palette

# Atari executable extension used by this project.
TYPE := prg

# Cross-compiler prefix installed on the development machine.
PREFIX := m68k-atari-mint

# Directory containing the small C runtime used by Atari programs.
LIBCMINI ?= /usr/libcmini/lib

# C compiler used to compile and link the program.
CC := $(PREFIX)-gcc

# Serial device connected to the RT68ICE board.
SERIAL_PORT ?= /dev/ttyACM0

# Hatari hard-disk directory where Atari applications are deployed.
DEPLOY_PATH ?= /home/michele/hatari/Harddisk/APPS

# Baud rate used by the RT68ICE serial connection.
SERIAL_BAUD ?= 57600

# Optimisation level; override it on the make command line if desired.
CFLAGS ?= -O2

# All targets that do not create a file with the same name.
.PHONY: all build clean deploy send send-setting-port

# Build the program by default.
all: build

# Link the application with the C runtime, libcmini, GCC support, and GEM bindings.
build: $(NAME).$(TYPE)

# Rebuild the executable whenever the C source changes.
$(NAME).$(TYPE): $(NAME).c
	$(CC) $(CFLAGS) -nostdlib $(LIBCMINI)/crt0.o $< -o $@ -s -L$(LIBCMINI) -lcmini -lgcc -lgem

# Remove only the executable generated by this Makefile.
clean:
	rm -f $(NAME).$(TYPE)

# Build the program and copy it to the Hatari applications directory.
deploy: build
	cp $(NAME).$(TYPE) $(DEPLOY_PATH)/

# Build the program, then send it through the serial port with ZMODEM.
send: build
	@echo "Start a ZMODEM receiver on the RT68ICE first, for example XYZ.TTP."
	@echo "Delete any old copy of $(NAME).$(TYPE) on the RT68ICE before receiving it."
	sz $(NAME).$(TYPE) > $(SERIAL_PORT) < $(SERIAL_PORT)

# Build the program, configure the serial device, then send it with ZMODEM.
send-setting-port: build
	@echo "Start a ZMODEM receiver on the RT68ICE first, for example XYZ.TTP."
	@echo "Delete any old copy of $(NAME).$(TYPE) on the RT68ICE before receiving it."
	stty -F $(SERIAL_PORT) $(SERIAL_BAUD) cs8 -parenb cstopb
	sz $(NAME).$(TYPE) > $(SERIAL_PORT) < $(SERIAL_PORT)
